# Copy to .env for local runs. Everything is optional: with nothing set, CareQueue uses a
# local SQLite file, an in-memory cache and queue, and keyword parsing for the assistant.

# DATABASE_URL=postgresql://carequeue:carequeue@localhost:5432/carequeue
# REDIS_URL=redis://localhost:6379/0
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# Natural-language booking through your NexusAI gateway (falls back to keyword rules if unreachable)
# NEXUSAI_URL=https://nexusai-latest.onrender.com
# NEXUSAI_API_KEY=
# NEXUSAI_TIMEOUT_S=3       # seconds a search waits for the LLM before the keyword rules answer

# CQ_HOLD_MINUTES=15        # how long a freed slot is held for the next waitlisted patient
# CQ_MIN_NOTICE_MINUTES=60  # don't offer slots that start sooner than this
# CQ_SEED_DEMO=1            # create demo providers, patients and bookings on an empty database
# CQ_BACKGROUND_WORKER=1    # run the worker inside the API process (set 0 when running carequeue.worker)
# Password for the sample accounts (maya.patel@demo.carequeue, harper.lopez@demo.carequeue, ...).
# Unset: nobody can sign in to them. Changing it takes effect on the next start.
# CQ_DEMO_PASSWORD=choose-a-password
# CQ_DEMO_LOGINS=0          # test-only sign-in shortcut; keep it off on a real server
# CQ_CLINIC_TIMEZONE=America/Los_Angeles  # used for the times in the FHIR API
